# Copy to .env and fill in. Generate a keypair with:
#   cd backend && go run . genvapid
VAPID_PUBLIC_KEY=BECsGyzLXcNVbTjlEjkTTr_5Cu-tzSW8Nyig5EnzV0m0weAY5E109NMBTnFFcN7wqpXuvMeEV3udBjTkEI5_BgA
VAPID_PRIVATE_KEY=Wq_UlNyS2ZeD0ccScO3jw9cihWYMuItL7SwqWIAFmbQ

# Contact URI sent to push services per the VAPID spec (mailto: or https:).
# Not required to be a real address you monitor.
VAPID_SUBJECT=mailto:admin@example.com

# One-time bootstrap credentials for the very first admin account. Only
# applied at boot if the users table is empty — once any account exists,
# these are ignored even if still set. Set them, start the backend once, log
# in, then remove both from your environment/.env file.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Comma-separated list of origins allowed to make credentialed (cookie-based)
# requests to the admin API — the deployed admin web app's origin and the
# local Vite dev server. Defaults to http://localhost:5174,https://localhost
# (the latter is what the Capacitor Android admin app's WebView calls from)
# if unset. Requests from other origins still work for the public storefront
# endpoints, just not the authenticated admin ones.
ADMIN_ORIGINS=http://localhost:5174,https://localhost

# Session cookie attributes. Leave at the secure defaults (true/none) for any
# deployment reachable over the network — the admin web app and API run on
# different origins, so the cookie is genuinely cross-site. For local HTTP
# development in a browser other than Chrome/Edge, use COOKIE_SECURE=false
# and COOKIE_SAMESITE=lax instead.
COOKIE_SECURE=true
COOKIE_SAMESITE=none

# Set to true to make the frontend call a locally running backend
# (http://localhost:8080). Leave unset or false to call the hosted API at
# https://namma-idli-api.0xlab.in
RUNNING_LOCALLY=false

# Firebase service account key (as one line of JSON), used to send order
# notifications to the native Android admin app via FCM. Generate one from
# Firebase Console -> Project settings -> Service accounts -> Generate new
# private key. Leave unset to disable native push (web push still works).
FCM_SERVICE_ACCOUNT_JSON=

# Base URL of a locally-hosted Ollama server (e.g. http://localhost:11434),
# used as the fallback parser for voice orders the admin app's on-device
# parser couldn't confidently resolve. Leave unset to disable the fallback —
# voice ordering still works for phrasing the on-device parser handles, it
# just won't have a backstop for anything odder. Needs a machine with enough
# RAM to run a small instruct model (llama3.2:3b or similar; ~4GB+).
OLLAMA_URL=
OLLAMA_MODEL=llama3.2:3b
