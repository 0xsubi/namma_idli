# Copy to .env and fill in. Generate a keypair with:
#   cd backend && go run . genvapid
VAPID_PUBLIC_KEY=BECsGyzLXcNVbTjlEjkTTr_5Cu-tzSW8Nyig5EnzV0m0weAY5E109NMBTnFFcN7wqpXuvMeEV3udBjTkEI5_BgA
VAPID_PRIVATE_KEY=Wq_UlNyS2ZeD0ccScO3jw9cihWYMuItL7SwqWIAFmbQ

# Contact URI sent to push services per the VAPID spec (mailto: or https:).
# Not required to be a real address you monitor.
VAPID_SUBJECT=mailto:admin@example.com

# Set to true to make the frontend call a locally running backend
# (http://localhost:8080). Leave unset or false to call the hosted API at
# https://namma-idli-api.0xlab.in
RUNNING_LOCALLY=false

# Firebase service account key (as one line of JSON), used to send order
# notifications to the native Android admin app via FCM. Generate one from
# Firebase Console -> Project settings -> Service accounts -> Generate new
# private key. Leave unset to disable native push (web push still works).
FCM_SERVICE_ACCOUNT_JSON=
