# Copy to .env and fill in. Generate a keypair with:
#   cd backend && go run . genvapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Contact URI sent to push services per the VAPID spec (mailto: or https:).
# Not required to be a real address you monitor.
VAPID_SUBJECT=mailto:admin@example.com

# Postgres credentials used by docker-compose (db + backend services).
# Change these before deploying anywhere reachable from outside your machine.
POSTGRES_DB=namma_idli
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Shared token the admin UI must send to use the staff-only APIs (items,
# bills, sales, analytics, order management, push). Defaults to "hunter2" if
# unset — change this before deploying anywhere reachable from outside your
# machine.
ADMIN_TOKEN=hunter2
